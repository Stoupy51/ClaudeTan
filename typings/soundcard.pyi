from types import TracebackType
from typing import Self

import numpy as np

class _Speaker:
	name: str

class _Recorder:
	def __enter__(self) -> Self: ...
	def __exit__(self, exc_type: type[BaseException] | None, exc: BaseException | None, tb: TracebackType | None) -> None: ...
	def record(self, numframes: int | None = None) -> np.ndarray[tuple[int, int], np.dtype[np.float32]]: ...

class _Microphone:
	def recorder(self, samplerate: int, channels: int | None = None, blocksize: int | None = None) -> _Recorder: ...

def default_speaker() -> _Speaker: ...
def get_microphone(id: str, include_loopback: bool = False) -> _Microphone: ...
