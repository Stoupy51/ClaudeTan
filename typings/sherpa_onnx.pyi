import numpy as np

class OnlineStream:
	def accept_waveform(self, sample_rate: int, waveform: np.ndarray[tuple[int], np.dtype[np.float32]]) -> None: ...

class KeywordSpotter:
	def __init__(self, tokens: str, encoder: str, decoder: str, joiner: str, keywords_file: str, num_threads: int = 2) -> None: ...
	def create_stream(self, keywords: str | None = None) -> OnlineStream: ...
	def is_ready(self, s: OnlineStream) -> bool: ...
	def decode_stream(self, s: OnlineStream) -> None: ...
	def get_result(self, s: OnlineStream) -> str: ...
	def reset_stream(self, s: OnlineStream) -> None: ...
