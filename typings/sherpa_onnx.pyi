import numpy as np

class OnlineStream:
	def accept_waveform(self, sample_rate: int, waveform: np.ndarray[tuple[int], np.dtype[np.float32]]) -> None: ...
	def input_finished(self) -> None: ...

class SpeakerEmbeddingExtractorConfig:
	def __init__(self, model: str) -> None: ...

class SpeakerEmbeddingExtractor:
	def __init__(self, config: SpeakerEmbeddingExtractorConfig) -> None: ...
	def create_stream(self) -> OnlineStream: ...
	def compute(self, stream: OnlineStream) -> list[float]: ...
